{
  "config_version": 1,
  "client": "Basilic Café — Démo",
  "url": "http://localhost:5000",

  "signature": {"mode": "manuel"},

  "mails": {
    "mode": "console",
    "hote": "smtp.example.com",
    "port": 587,
    "utilisateur": "rh@basiliccafe.example",
    "expediteur": "rh@basiliccafe.example",
    "rh": ["rh@basiliccafe.example"],
    "dpae": null,
    "recap": null,
    "comptable_defaut": "compta@basiliccafe.example"
  },

  "motifs_ko": [
    "Pièce illisible ou manquante",
    "Informations incohérentes",
    "Établissement ou poste erroné",
    "Rémunération à revoir",
    "Autre"
  ],

  "templates": [
    {"quand": {"poste": "Equipier Polyvalent", "temps_partiel": "OUI"}, "modele": "Equipier_Partiel.html"},
    {"quand": {"poste": "Equipier Polyvalent"}, "modele": "Equipier.html"},
    {"quand": {"poste": "Assistant Manager"}, "modele": "Assistant_Manager.html"},
    {"quand": {"poste": "Manager"}, "modele": "Manager.html"}
  ],

  "critiques": ["SalaireChiffres", "SalaireLettres"],

  "derives": [
    {"placeholder": "Nationalite",
     "si": ["nationalite", "==", "Autres"],
     "alors": "{{NationaliteEtrangere}}", "sinon": "française"},
    {"placeholder": "BlocAutorisationTravail",
     "si": ["nationalite", "==", "Autres"],
     "alors": "<p>Le salarié déclare être titulaire d'un titre de séjour de type « {{TypeAutorisation}} », valable jusqu'au {{DateFinValidite}}, l'autorisant à occuper un emploi salarié sur le territoire français.</p>",
     "sinon": ""},
    {"placeholder": "DureeMensuelle", "format": "mensualise", "de": "TempsTravail"},
    {"placeholder": "Semaine1", "format": "nombre", "de": "TempsTravail"},
    {"placeholder": "Semaine2", "format": "nombre", "de": "TempsTravail"},
    {"placeholder": "Semaine3", "format": "nombre", "de": "TempsTravail"},
    {"placeholder": "Semaine4", "format": "nombre", "de": "TempsTravail"}
  ]
}
